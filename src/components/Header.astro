---
const links = [
  { href: "/projects", label: "projects" },
  { href: "/thoughts", label: "thoughts" },
  { href: "/about", label: "about" },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<header
  class="header headline mx-4 md:mx-0 sticky top-2 mt-4 z-50 flex flex-row items-center justify-between gap-4 rounded-xl hover:border-primary/40 transition-colors duration-500 text-text-body border-border border"
>
  <a href="/" class="text-sm p-4 -m-4">
    <span class="text-text-heading font-bold">dayan</span>grah.am
  </a>
  <nav class="flex gap-3 sm:gap-5">
    {
      links.map(({ href, label }) => (
        <a
          href={href}
          class="nav-link text-sm p-4 -m-4"
          aria-current={path.startsWith(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* Solid, with a mask over the strip above the sticky header so content
     doesn't peek through as it scrolls. */
  .header,
  .header::before {
    @apply bg-background;
  }
  .header::before {
    content: "";
    position: absolute;
    inset: -1rem -1rem auto;
    height: 1rem;
    z-index: -1;
  }
  @media (min-width: 768px) {
    .header::before {
      inset: -1rem 0 auto;
    }
  }
  .nav-link {
    transition: color 150ms ease;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    @apply text-primary;
  }
</style>

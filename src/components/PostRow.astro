---
import { formatDate } from "../lib/helpers";

interface Props {
  title: string;
  date: Date;
  url: string;
}

const { title, date, url } = Astro.props;
---

<li class="border-b border-dashed border-border font-mono">
  <a
    class="group flex items-baseline justify-between gap-6 py-3 text-sm md:text-base"
    href={url}
  >
    <span
      class="min-w-0 text-text-subheading transition-colors group-hover:text-primary"
    >
      {title}
    </span>
    <time
      class="shrink-0 whitespace-nowrap text-right text-xs md:text-sm tabular-nums text-text-description"
      datetime={date.toISOString()}
    >
      {formatDate(date)}
    </time>
  </a>
</li>

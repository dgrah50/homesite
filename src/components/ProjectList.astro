---
import PostRow from "./PostRow.astro";

interface Props {
  basePath?: string;
  posts: Array<{
    data: {
      title?: string;
      pubDate?: Date;
    };
    id: string;
  }>;
}

const { posts, basePath = "/projects" } = Astro.props;
---

<ul class="w-full">
  {
    posts.map((post) => (
      <PostRow
        title={post.data.title || "No title"}
        date={post.data.pubDate || new Date()}
        url={`${basePath}/${post.id}`}
      />
    ))
  }
</ul>

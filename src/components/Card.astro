---
interface Props {
  title: string;
  body: string;
  href: string;
}

const { href, title, body } = Astro.props;
---

<a
  href={href}
  class="card group flex flex-col h-full rounded-lg border border-border bg-background p-3 font-mono transition-all duration-300"
>
  <h3
    class="text-sm text-text-subheading mb-2 transition-colors group-hover:text-primary group-focus-visible:text-primary"
  >
    {title}
    <span
      class="inline-block ml-1 transition-transform duration-300 group-hover:translate-x-1"
      aria-hidden="true">&rarr;</span
    >
  </h3>
  <p class="text-sm text-text-description">{body}</p>
</a>

<style>
  .card:hover,
  .card:focus-visible {
    outline: none;
    border-color: rgba(164, 237, 81, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card * {
      transition: none;
    }
  }
</style>

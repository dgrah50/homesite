---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | dayangrah.am" description="Page not found.">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-headline headline text-text-primary mb-4">404</h1>
    <p class="text-text-body font-mono text-sm mb-8">this page doesn't exist</p>
    <a
      href="/"
      class="text-sm font-mono text-text-body border border-border rounded-xl px-4 py-2 hover:border-primary hover:text-text-heading transition-all duration-300"
    >
      back home
    </a>
  </div>
</BaseLayout>

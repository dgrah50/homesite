---
import { getCollection } from "astro:content";
import Layout from "../../layouts/HomeLayout.astro";
import ProjectList from "../../components/ProjectList.astro";

const posts = (await getCollection("thoughts"))?.sort(
  (blogEntryA, blogEntryB) =>
    (blogEntryB.data.pubDate || new Date()).getTime() -
    (blogEntryA.data.pubDate || new Date()).getTime()
);
---

<Layout title="thoughts | dayangrah.am" description="Thoughts on software engineering, learning, and life by Dayan Graham.">
  <div class="w-full pt-12 pb-8">
    <h1 class="headline text-4xl md:text-headline text-text-heading mb-8">
      thoughts
    </h1>
    <ProjectList posts={posts} basePath="/thoughts" />
  </div>
</Layout>

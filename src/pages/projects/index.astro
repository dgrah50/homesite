---
import { getCollection } from "astro:content";
import Layout from "../../layouts/HomeLayout.astro";
import ProjectList from "../../components/ProjectList.astro";

const posts = (await getCollection("projects"))?.sort(
  (blogEntryA, blogEntryB) =>
    (blogEntryB.data.pubDate || new Date()).getTime() -
    (blogEntryA.data.pubDate || new Date()).getTime()
);
---

<Layout title="projects | dayangrah.am" description="Things Dayan Graham has built - AI, IoT, open source, and more.">
  <div class="w-full pt-12 pb-8">
    <h1 class="headline text-4xl md:text-headline text-text-heading mb-8">
      projects
    </h1>
    <ProjectList posts={posts} />
  </div>
</Layout>

---
import Layout from "../layouts/HomeLayout.astro";
import Card from "../components/Card.astro";
import HeroCard from "../components/HeroCard.astro";
import Section from "../components/Section.astro";
import { getCollection } from "astro:content";

// Featured projects: latest 2 + magic table pinned at 3rd
const allProjects = await getCollection("projects");
const sorted = allProjects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const top2 = sorted.filter((p) => p.id !== "magic-table").slice(0, 2);
const magicTable = allProjects.find((p) => p.id === "magic-table");
const latestProjects = magicTable ? [...top2, magicTable] : sorted.slice(0, 3);

const latestThoughts = await getCollection("thoughts").then((thoughts) =>
  thoughts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3)
);

const sections = [
  {
    title: "some stuff i've built",
    moreLink: "/projects/",
    cards: latestProjects.map((project) => ({
      title: project.data.title,
      body: project.data.description,
      href: `/projects/${project.id}`,
    })),
  },
  {
    title: "some stuff i've thought about",
    moreLink: "/thoughts/",
    cards: latestThoughts.map((thought) => ({
      title: thought.data.title,
      body: thought.data.description,
      href: `/thoughts/${thought.id}`,
    })),
  },
];
---

<Layout title="dayangrah.am" description="Dayan Graham - software engineer based in the Cayman Islands. Projects, thoughts, and more.">
  <div class="flex flex-col items-center text-black bg-background">
    <HeroCard class="my-8" />
    {
      sections.map(({ title, moreLink, cards }) => (
        <Section title={title} moreLink={moreLink}>
          {cards.map((card) => (
            <Card {...card} />
          ))}
        </Section>
      ))
    }
  </div>
</Layout>

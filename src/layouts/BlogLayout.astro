---
import BaseLayout from "./BaseLayout.astro";
import "./BlogLayout.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const ogTitle = `${title} | dayangrah.am`;
---

<BaseLayout title={title} description={description} ogTitle={ogTitle}>
  <header class="mt-12 mb-12">
    <h1 class="headline text-primary text-4xl md:text-headline leading-tight">
      {title}
    </h1>
    <p class="mt-2 font-mono text-text-body">{description}</p>
  </header>
  <article class="article pb-12">
    <slot />
  </article>
</BaseLayout>

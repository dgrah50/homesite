---
import BaseLayout from "./BaseLayout.astro";
import SplashScreen from "../components/SplashScreen.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}

const { title, description, ogTitle } = Astro.props;
---

<BaseLayout title={title} description={description} ogTitle={ogTitle}>
  <SplashScreen slot="intro" />
  <slot />
</BaseLayout>
